# HackerOne API Credentials
HACKERONE_USERNAME=your_hackerone_username
HACKERONE_API_TOKEN=your_hackerone_api_token
# Optional: Set to mock for offline testing without real credentials (options: api, mock)
HACKERONE_ADAPTER=api
# Optional: Custom verification header sent with HTTP requests for HackerOne policy compliance
HACKERONE_VERIFICATION_HEADER=X-HackerOne-Research: your_hackerone_username


# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789
# Optional admin confirmation token for sensitive commands (/start, /stop, /scan)
TELEGRAM_ADMIN_PIN=

# Database Configuration
DATABASE_URL=sqlite://data/bountyscope.db

# Concurrency & Queue Configuration
MAX_CONCURRENT_JOBS=10
REQUEST_TIMEOUT_SECONDS=30
PROCESS_TIMEOUT_SECONDS=600
RETRY_COUNT=3

# Scope Monitoring
SCOPE_POLL_INTERVAL_SECONDS=300

# Scanner Settings
NUCLEI_SEVERITIES=medium,high,critical
NUCLEI_TEMPLATES=
NUCLEI_TAGS=

# External Tool Executable Paths
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx
KATANA_PATH=katana
GAU_PATH=gau
NUCLEI_PATH=nuclei
# XSS Hunter (go install github.com/hahwul/dalfox/v2@latest)
DALFOX_PATH=/home/yaseen/go/bin/dalfox
# Hidden Parameter Discovery (pipx install arjun)
ARJUN_PATH=/home/yaseen/.local/bin/arjun



# Data Directories
DATA_DIR=data
REPORTS_DIR=reports
LOGS_DIR=logs
